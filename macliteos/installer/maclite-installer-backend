#!/bin/sh
# G1OS safe installer backend.
# Destructive operations are explicit, validated and fail closed.
# Progress is authoritative. Long operations emit activity heartbeats while
# keeping the last measured percentage unchanged.
set -eu

DRY_RUN=0
TARGET=""
JSON=0
CURRENT_PROGRESS=0
CURRENT_MESSAGE="Preparing installation"

fail() {
  echo "ERROR: $*" >&2
  if [ "$JSON" = 1 ]; then
    printf '{"status":"error","message":"%s"}\n' "$*"
  fi
  exit 1
}

step() {
  CURRENT_PROGRESS=$2
  CURRENT_MESSAGE=$3
  echo "[STEP $1 ($2%%)]: $3"
  if [ "$JSON" = 1 ]; then
    printf '{"step":%s,"progress":%s,"message":"%s"}\n' "$1" "$2" "$3"
  fi
}

# Execute one real operation asynchronously so the installer UI can distinguish
# measurable progress from activity. Heartbeats repeat the SAME authoritative
# percentage; they never advance progress.
run() {
  echo "+ $*"
  if [ "$DRY_RUN" = 1 ]; then
    return 0
  fi

  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
      if [ "$JSON" = 1 ]; then
        printf '{"type":"activity","progress":%s,"message":"%s"}\n' "$CURRENT_PROGRESS" "$CURRENT_MESSAGE"
      else
        echo "[ACTIVITY ${CURRENT_PROGRESS}%%]: ${CURRENT_MESSAGE}"
      fi
    fi
  done

  wait "$pid" || fail "command failed: $*"
}

need() { command -v "$1" >/dev/null 2>&1 || fail "required command missing: $1"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target=*) TARGET=${1#*=} ;;
    --target) [ "$#" -ge 2 ] || fail "--target requires a disk"; shift; TARGET=$1 ;;
    --dry-run) DRY_RUN=1 ;;
    --json) JSON=1 ;;
    -h|--help) echo "usage: maclite-installer-backend --target <disk> [--dry-run] [--json]"; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
  shift
done

[ "$(id -u)" = 0 ] || [ "$DRY_RUN" = 1 ] || fail "installer backend must run as root"
[ -n "$TARGET" ] || fail "no target disk supplied; installer will never guess a disk"
case "$TARGET" in /dev/*) TARGET=${TARGET#/dev/} ;; esac
case "$TARGET" in ''|.|..|*[!A-Za-z0-9._-]*) fail "invalid target disk identifier" ;; esac

DEV="/dev/$TARGET"
[ "$DRY_RUN" = 1 ] || [ -b "$DEV" ] || fail "target block device does not exist: $DEV"
[ "$DRY_RUN" = 1 ] || [ -e "/sys/block/$TARGET" ] || fail "target is not a whole block disk: $DEV"
case "$TARGET" in loop*|ram*|sr*|dm-*|md*|zram*) fail "refusing non-physical installation target: $DEV" ;; esac

BOOT_DISK=""
for mp in /run/maclite-base /run/maclite-live /cdrom /mnt/live; do
  [ -d "$mp" ] || continue
  src=$(findmnt -n -o SOURCE "$mp" 2>/dev/null || true)
  [ -n "$src" ] || continue
  case "$src" in
    /dev/*)
      b=${src#/dev/}
      b=$(printf '%s' "$b" | sed -E 's/p?[0-9]+$//')
      [ -e "/sys/block/$b" ] && { BOOT_DISK=$b; break; }
      ;;
  esac
done

[ -z "$BOOT_DISK" ] || [ "$TARGET" != "$BOOT_DISK" ] || fail "refusing to install to active live USB: $DEV"
if [ "$DRY_RUN" = 0 ]; then
  if lsblk -nrpo NAME,MOUNTPOINT "$DEV" | awk '$2 != "" {print $1}' | grep -q .; then
    fail "target disk or one of its partitions is mounted: $DEV"
  fi
fi

MODEL=$(cat "/sys/block/$TARGET/device/model" 2>/dev/null || echo "unknown")
SERIAL=$(cat "/sys/block/$TARGET/device/serial" 2>/dev/null || echo "unknown")
SECTORS=$(cat "/sys/block/$TARGET/size" 2>/dev/null || echo 0)
SIZE_GB=$((SECTORS * 512 / 1000 / 1000 / 1000))
echo "SELECTED DISK: /dev/$TARGET"
echo "MODEL: $MODEL"
echo "SERIAL/IDENTIFIER: $SERIAL"
echo "SIZE: ${SIZE_GB} GB"
echo "LIVE MEDIA: ${BOOT_DISK:-not detected}"

need sgdisk; need mkfs.vfat; need mkfs.ext4; need blkid; need mount; need umount; need lsblk; need partprobe; need grub-mkimage; need mktemp

PREF=$TARGET
case "$TARGET" in nvme*|mmcblk*) PREF=${TARGET}p ;; esac
DEV_BOOT=/dev/${PREF}1
DEV_DATA=/dev/${PREF}2
DEV_BASE=/dev/${PREF}3

LIVE_BASE=""
for p in /run/maclite-base /run/maclite-live; do
  if [ -d "$p" ] && [ -n "$(find "$p" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null || true)" ]; then LIVE_BASE=$p; break; fi
done
[ -n "$LIVE_BASE" ] || fail "live G1OS base is unavailable; refusing to create an empty installation"

KERNEL=""
INITRD=""
for p in /boot/vmlinuz-maclite /run/maclite-live/boot/vmlinuz-maclite; do [ -s "$p" ] && { KERNEL=$p; break; }; done
for p in /boot/initrd-maclite.img /run/maclite-live/boot/initrd-maclite.img; do [ -s "$p" ] && { INITRD=$p; break; }; done
[ -n "$KERNEL" ] || fail "real G1OS kernel image not found"
[ -n "$INITRD" ] || fail "real G1OS initramfs not found"

step 1 10 "Validated target disk, live media, base system, kernel and initramfs"
step 2 20 "Unmounting target partitions"
if [ "$DRY_RUN" = 0 ]; then
  while read -r part; do
    [ -n "$part" ] || continue
    umount "$part" || fail "failed to unmount target partition: $part"
  done <<EOF
$(lsblk -lnpo NAME "$DEV" | tail -n +2)
EOF
fi

step 3 30 "Repartitioning target with EFI, persistent data and root partitions"
run sgdisk --zap-all "$DEV"
run sgdisk -n 1:0:+256M -t 1:ef00 -c 1:MACLITE_BOOT "$DEV"
run sgdisk -n 2:0:+4G -t 2:8300 -c 2:MACLITE_DATA "$DEV"
run sgdisk -n 3:0:0 -t 3:8300 -c 3:MACLITE_BASE "$DEV"
run partprobe "$DEV"

step 4 40 "Formatting fresh filesystems"
run mkfs.vfat -F32 -n MACLITE_BOOT "$DEV_BOOT"
run mkfs.ext4 -F -L MACLITE_DATA "$DEV_DATA"
run mkfs.ext4 -F -L MACLITE_BASE "$DEV_BASE"
BOOT_UUID=$(blkid -s UUID -o value "$DEV_BOOT") || fail "unable to read EFI UUID"
DATA_UUID=$(blkid -s UUID -o value "$DEV_DATA") || fail "unable to read data UUID"
BASE_UUID=$(blkid -s UUID -o value "$DEV_BASE") || fail "unable to read root UUID"
BASE_PARTUUID=$(blkid -s PARTUUID -o value "$DEV_BASE") || fail "unable to read root PARTUUID"

step 5 55 "Installing the verified live base onto the target root filesystem"
BASE_MNT=$(mktemp -d /tmp/g1os-base.XXXXXX)
BOOT_MNT=$(mktemp -d /tmp/g1os-boot.XXXXXX)
cleanup() {
  umount "$BASE_MNT" 2>/dev/null || true
  umount "$BOOT_MNT" 2>/dev/null || true
  rmdir "$BASE_MNT" "$BOOT_MNT" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM
run mount "$DEV_BASE" "$BASE_MNT"
run cp -a "$LIVE_BASE/." "$BASE_MNT/"
mkdir -p "$BASE_MNT/etc"
cat > "$BASE_MNT/etc/fstab" <<EOF
UUID=$BASE_UUID  /          ext4  ro,noatime,errors=remount-ro  0 1
UUID=$DATA_UUID  /var/data  ext4  rw,noatime,errors=remount-ro  0 2
UUID=$BOOT_UUID  /boot/efi  vfat  rw,umask=0077               0 1
EOF
printf '%s\n' "INSTALLED_DISK=/dev/$TARGET" "INSTALLED_SERIAL=$SERIAL" "INSTALLED_BASE_UUID=$BASE_UUID" "INSTALLED_BASE_PARTUUID=$BASE_PARTUUID" "INSTALLED_BOOT_UUID=$BOOT_UUID" "INSTALLED_DATA_UUID=$DATA_UUID" > "$BASE_MNT/etc/g1os-installed"
run sync
run umount "$BASE_MNT"

step 6 70 "Installing fallback EFI bootloader and UUID-bound boot configuration"
run mount "$DEV_BOOT" "$BOOT_MNT"
mkdir -p "$BOOT_MNT/EFI/BOOT" "$BOOT_MNT/boot/grub"
run grub-mkimage -O x86_64-efi -o "$BOOT_MNT/EFI/BOOT/BOOTX64.EFI" -p /boot/grub part_gpt part_msdos fat ext2 linux search search_fs_uuid normal
cat > "$BOOT_MNT/EFI/BOOT/grub.cfg" <<EOF
set default=0
set timeout=3
insmod part_gpt
insmod fat
insmod search_fs_uuid
search --no-floppy --fs-uuid --set=boot $BOOT_UUID
set root=(\$boot)
menuentry "G1OS" {
  search --no-floppy --fs-uuid --set=boot $BOOT_UUID
  linux /boot/vmlinuz-g1os root=UUID=$BASE_UUID ro rd.maclite=1
  initrd /boot/initrd-g1os.img
}
menuentry "G1OS Safe Graphics" {
  search --no-floppy --fs-uuid --set=boot $BOOT_UUID
  linux /boot/vmlinuz-g1os root=UUID=$BASE_UUID ro rd.maclite=1 maclite.gl=off
  initrd /boot/initrd-g1os.img
}
menuentry "G1OS Recovery" {
  search --no-floppy --fs-uuid --set=boot $BOOT_UUID
  linux /boot/vmlinuz-g1os root=UUID=$BASE_UUID ro rd.maclite=recovery
  initrd /boot/initrd-g1os.img
}
EOF
run cp "$BOOT_MNT/EFI/BOOT/grub.cfg" "$BOOT_MNT/boot/grub/grub.cfg"
run cp "$KERNEL" "$BOOT_MNT/boot/vmlinuz-g1os"
run cp "$INITRD" "$BOOT_MNT/boot/initrd-g1os.img"
printf 'G1OS' > "$BOOT_MNT/.disk_label"

step 7 82 "Verifying EFI, kernel, initramfs and UUID references before success"
[ "$DRY_RUN" = 1 ] || [ -s "$BOOT_MNT/EFI/BOOT/BOOTX64.EFI" ] || fail "EFI fallback loader is missing or empty"
[ "$DRY_RUN" = 1 ] || [ -s "$BOOT_MNT/boot/vmlinuz-g1os" ] || fail "installed kernel is missing or empty"
[ "$DRY_RUN" = 1 ] || [ -s "$BOOT_MNT/boot/initrd-g1os.img" ] || fail "installed initramfs is missing or empty"
[ "$DRY_RUN" = 1 ] || grep -F "root=UUID=$BASE_UUID" "$BOOT_MNT/EFI/BOOT/grub.cfg" >/dev/null || fail "GRUB root UUID mismatch"
[ "$DRY_RUN" = 1 ] || ! grep -Eq '/dev/(sd|nvme|mmcblk)' "$BOOT_MNT/EFI/BOOT/grub.cfg" || fail "GRUB contains unstable device-path references"
run sync
run umount "$BOOT_MNT"

step 8 92 "Verifying installed root filesystem"
if [ "$DRY_RUN" = 0 ]; then
  VERIFY_MNT=$(mktemp -d /tmp/g1os-verify.XXXXXX)
  mount "$DEV_BASE" "$VERIFY_MNT" || fail "cannot remount target root for verification"
  [ -s "$VERIFY_MNT/etc/fstab" ] || { umount "$VERIFY_MNT"; fail "installed fstab missing"; }
  grep -F "UUID=$BOOT_UUID" "$VERIFY_MNT/etc/fstab" >/dev/null || { umount "$VERIFY_MNT"; fail "EFI UUID missing from fstab"; }
  umount "$VERIFY_MNT" || fail "verification unmount failed"
  rmdir "$VERIFY_MNT"
fi

step 9 100 "Installation verification passed"
echo "SUCCESS: G1OS installation completed and passed pre-flight verification on /dev/$TARGET."
