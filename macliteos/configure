#!/usr/bin/env bash
# MacLiteOS configure — probes the *build host* for optional accelerators and
# writes out/config.mk. Everything optional is optional: the core (software
# compositor, shell, tools, tests) builds with nothing but a C11 compiler.
set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"
OUT="$ROOT/out"
mkdir -p "$OUT"
CC=${CC:-gcc}
PKGCONFIG=$(command -v pkg-config || true)

HAVE=()
MISS=()
EXTRA_CFLAGS=""
EXTRA_LIBS=""

probe() { # name  include  libs  define
  local name="$1" inc="$2" libs="$3" def="$4"
  local src="$OUT/.probe_$name.c"
  cat > "$src" <<EOF
#include <$inc>
int main(void){ return 0; }
EOF
  if $CC -std=gnu11 $EXTRA_CFLAGS -o "$OUT/.probe_$name" "$src" $libs >/dev/null 2>&1; then
    HAVE+=("$name"); eval "ML_HAVE_${def}=1"
    echo "  yes  $name"
  else
    MISS+=("$name"); eval "ML_HAVE_${def}=0"
    echo "  no   $name (optional)"
  fi
  rm -f "$OUT/.probe_$name" "$src"
}

echo "MacLiteOS configure"
echo "  host kernel : $(uname -sr)"
echo "  compiler    : $($CC -dumpversion 2>/dev/null || echo '?')"
echo "  pkg-config  : ${PKGCONFIG:-not found}"
echo
echo "probing optional graphics/audio/media backends:"

# --- headers + libs -------------------------------------------------------
CFLAGS_DRM=""; LIBS_DRM=""
if [ -n "$PKGCONFIG" ]; then
  if $PKGCONFIG --exists libdrm gbm 2>/dev/null; then
    CFLAGS_DRM="$($PKGCONFIG --cflags libdrm gbm)"; LIBS_DRM="$($PKGCONFIG --libs libdrm gbm)"
  fi
  if $PKGCONFIG --exists egl glesv2 2>/dev/null; then
    EXTRA_CFLAGS="$EXTRA_CFLAGS $($PKGCONFIG --cflags egl glesv2)"
    EXTRA_LIBS="$EXTRA_LIBS $($PKGCONFIG --libs egl glesv2)"
    ML_HAVE_EGL=1
  else
    ML_HAVE_EGL=0
  fi
  if $PKGCONFIG --exists freetype2 2>/dev/null; then
    EXTRA_CFLAGS="$EXTRA_CFLAGS $($PKGCONFIG --cflags freetype2)"
    EXTRA_LIBS="$EXTRA_LIBS $($PKGCONFIG --libs freetype2)"
    ML_HAVE_FREETYPE=1
  else
    ML_HAVE_FREETYPE=0
  fi
  if $PKGCONFIG --exists libudev 2>/dev/null; then
    EXTRA_CFLAGS="$EXTRA_CFLAGS $($PKGCONFIG --cflags libudev)"
    EXTRA_LIBS="$EXTRA_LIBS $($PKGCONFIG --libs libudev)"
    ML_HAVE_UDEV=1
  else
    ML_HAVE_UDEV=0
  fi
else
  ML_HAVE_EGL=0; ML_HAVE_FREETYPE=0; ML_HAVE_UDEV=0
fi

if [ -n "$CFLAGS_DRM" ]; then
  EXTRA_CFLAGS="$EXTRA_CFLAGS $CFLAGS_DRM"; EXTRA_LIBS="$EXTRA_LIBS $LIBS_DRM"; ML_HAVE_DRM=1
  echo "  yes  libdrm+gbm (headers present — not used: MacLiteOS talks to DRM directly)"
else
  ML_HAVE_DRM=0
fi
# The v0.2 DRM/KMS present backend (hardware/kms.c) uses the kernel UAPI through
# <linux/*.h> and ioctl(2): no libdrm, no gbm, no EGL. It is therefore ALWAYS
# available, and this probe only reports whether a card exists on the build host.
if [ -d /dev/dri ] && ls /dev/dri/card* >/dev/null 2>&1; then
  echo "  yes  /dev/dri card present (KMS backend usable on this host)"
else
  echo "  n/a  no /dev/dri here (KMS backend still compiles; it selects fbdev/headless)"
fi
echo "       note: DRM/KMS + fbdev backends need no optional library; 'make' always builds them"
echo "       note: userspace for libdrm/EGL/ALSA is NOT a dependency — see docs/gpu.md" 
[ "$ML_HAVE_EGL" = 1 ] && echo "  yes  EGL/GLES2 (GL compositor path)" || echo "  no   EGL/GLES2 (software compositor only)"
[ "$ML_HAVE_FREETYPE" = 1 ] && echo "  yes  freetype2 (TTF text)" || echo "  no   freetype2 (built-in Mica Sans vector face)"
[ "$ML_HAVE_UDEV" = 1 ] && echo "  yes  libudev (hotplug)" || echo "  no   libudev (netlink/procfs hotplug fallback)"

probe x11 "X11/Xlib.h" "-lX11" "X11"
probe alsa "alsa/asoundlib.h" "-lasound" "ALSA"

# libmpv / gstreamer are header-only checks (linked dlopen-style at runtime)
for h in mpv/client.h gst/gst.h; do
  n=$(basename $(dirname $h))
  if [ -f /usr/include/$h ]; then echo "  yes  $h"; else echo "  no   $h (optional media backend)"; fi
done

# --- build host tools used by build.sh ------------------------------------
echo
echo "image/iso tooling on this host:"
for t in xorriso grub-mkrescue mksquashfs mkfs.ext4 mkfs.vfat mmdosfsimg qemu-system-x86_64 debootstrap mmdebstrap cpio objcopy; do
  if command -v "$t" >/dev/null 2>&1; then echo "  yes  $t"; else echo "  no   $t"; fi
done

cat > "$OUT/config.mk" <<EOF
# generated by configure on $(date -u +%Y-%m-%dT%H:%M:%SZ) — do not edit
ML_HAVE_DRM      := $ML_HAVE_DRM
ML_HAVE_EGL      := $ML_HAVE_EGL
ML_HAVE_FREETYPE := $ML_HAVE_FREETYPE
ML_HAVE_UDEV     := $ML_HAVE_UDEV
ML_HAVE_X11      := $ML_HAVE_X11
ML_HAVE_ALSA     := $ML_HAVE_ALSA
ML_EXTRA_CFLAGS  := $EXTRA_CFLAGS
ML_EXTRA_LIBS    := $EXTRA_LIBS
EOF
for d in DRM EGL FREETYPE UDEV X11 ALSA; do
  v=$(eval echo \$ML_HAVE_$d)
  [ "$v" = 1 ] && echo "ML_HAVE_$d := 1" >> "$OUT/config.mk"
done
echo
echo "wrote out/config.mk"
