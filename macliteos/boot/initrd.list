# Minimal initramfs content. Every entry exists for a reason; nothing else ships.
/bin/busybox            # or the curated toolset below if busybox is unwanted
/sbin/switch_root
/usr/bin/mica-comp      # compositor + session supervisor (starts the desktop)
/usr/bin/mica-shell     # panel/dock/desktop roles
/lib/firmware/b43/*     # BCM43224 firmware (unfortunately large; see ROADMAP)
/lib/modules/*/kernel/drivers/gpu/drm/radeon/radeon.ko
/lib/modules/*/kernel/drivers/net/ethernet/broadcom/tg3.ko
/lib/modules/*/kernel/drivers/net/wireless/b43/b43.ko
/lib/modules/*/kernel/sound/snd-hda-intel.ko
/etc/maca-lite/mode     # default performance mode (beautiful|balanced|performance)
# v0.2 hardening: the diagnostics are initramfs-resident so a machine that never
# reaches the session can still be inspected (they are ~10-40 kB each).
/usr/bin/maclite-hardware
/usr/bin/maclite-gpu
/usr/bin/maclite-display
/usr/bin/maclite-brightness
/usr/bin/maclite-audio
/usr/bin/maclite-video-test
/usr/bin/maclite-network
/usr/bin/maclite-usb
/usr/bin/maclite-storage
/usr/bin/maclite-power
/usr/bin/maclite-cpu
/usr/bin/maclite-drivers
/usr/bin/maclite-gpu-benchmark
/usr/share/maca-lite/catalog/maclite-offline.cat   # what this image ships and why
# recovery path referenced by the cmdline (rd.maclite=recovery)
/usr/bin/maclite-recovery
